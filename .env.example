# ==========================================
# SynBio LATAM Agent - Environment Config
# ==========================================

# Configuración del Proveedor LLM
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Configuración de Base de Datos PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@localhost:5432/synbio_latam_db

# Entorno de Ejecución (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO